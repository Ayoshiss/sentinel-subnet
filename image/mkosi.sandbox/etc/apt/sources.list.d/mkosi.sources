# Every pocket from one dated snapshot, including security. mkosi's default
# takes security updates from the live archive, which would make the image
# depend on the day it was built.
Types: deb
URIs: https://snapshot.ubuntu.com/ubuntu/20261106T000000Z
Suites: noble noble-updates noble-security
Components: main universe
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
