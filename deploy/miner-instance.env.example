# Copy to /etc/sentinel/miner-<PORT>.env, one per additional miner instance.
# The filename's port is what systemd passes as the instance name, so
# /etc/sentinel/miner-8092.env belongs to sentinel-miner@8092.
#
# No key material here. The miner serves under an address and holds none of its
# hotkey's private key; publish the endpoint separately with
# scripts/publish_axon.py from the machine that does hold the wallet.

BIND=10.128.0.6

# This instance's own registered hotkey address. Each instance needs its own, or
# they are one miner wearing three hats and the majority is still one voice.
HOTKEY_SS58=

# The chip's launch measurement. Identical across instances on one host, because
# they are one attested machine running several processes.
MEASUREMENT=

# Validators permitted to call this instance. Named explicitly so it can start
# when the chain is unreachable. Unbraced in the unit so systemd splits it.
ALLOW_ARGS=--allow-hotkey 5H5uDA7TRyisfPLgRJaFYhVZEQ7mhKPb2mZJVwSw6UvKo3RV --allow-hotkey 5FdvBe8VmzqUQdvxtyb3WxEfRJn1JU2KnRiT8X5iwZHAgddf --no-allow-validators
