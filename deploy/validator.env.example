# Copy to /etc/sentinel/validator.env and fill in.
#
#   sudo install -m 0640 -o root -g sentinel \
#       deploy/validator.env.example /etc/sentinel/validator.env
#
# Nothing secret is in here. The hotkey lives in the wallet directory, not in
# this file, so 0640 is tidiness rather than a security boundary.

NETUID=554
WALLET=sentinel
HOTKEY=validator

# The approved launch measurement, from TESTNET.md. Take it from there rather
# than from a miner: a miner supplying the measurement it is checked against is
# grading its own homework.
#
# It changes when the host firmware does, which includes moving between zones of
# the same cloud, so check TESTNET.md rather than assuming this default is
# current.
MEASUREMENT=ccdc5cf01ba25526bd65503d95931b787b4385a3277cfe4448addf9c3e894948ae8cf7b099620e3e22717de2fb5d26fa
