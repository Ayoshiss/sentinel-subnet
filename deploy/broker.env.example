# Copy to /etc/sentinel/broker.env, chmod 0600, chown root:root.
#
# This file is the secret. The whole design reduces to: this file exists on the
# customer's machine and not on the miner's.

BIND=0.0.0.0
PORT=8100
PRODUCT=Milan

# The approved launch measurement, hex. Measured per host: the same image on a
# different machine measures differently, so this is not a fleet-wide constant.
# Read it from the enclave with: run_miner.py --print-measurement
# Repeatable: MEASUREMENT_ARGS=--measurement aaa... --measurement bbb...
MEASUREMENT_ARGS=--measurement 

# One --scope per database role. Each should hold SELECT on the views that scope
# is allowed and nothing else, so that even a total failure above this line
# bounds what is reachable. See docs/scoping.sql.
SCOPE_ARGS=--scope analytics=postgresql://sentinel_analytics:CHANGEME@localhost/app
