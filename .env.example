# Copy to .env and fill in real values
# Never commit .env

# Gateway auth — your customers use this key
API_KEY=sk_live_taogateway_dev

# Chutes SN64 — get from https://chutes.ai (sign up, generate API key)
CHUTES_API_KEY=

# Optional: override default model
DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# Admin secret — required to create customers/keys. Generate with: openssl rand -hex 32
ADMIN_SECRET=
